apiVersion: platform.confluent.io/v1beta1
kind: Connector
metadata:
  name: mq-source
  namespace: <namespace>
spec:
  class: com.ibm.eventstreams.connect.mqsource.MQSourceConnector
  taskMax: 1
  connectClusterRef:
    name: <connect-cluster-name>

  configs:
    mq.queue.manager: "VITWE01"
    mq.connection.name.list: "mq-host.example.com(1414)"
    mq.channel.name: "ADTI.SRV01"
    mq.queue: "SOURCE.QUEUE"

    mq.username: "${file:/vault/secrets/mq-credentials.properties:username}"
    mq.password: "${file:/vault/secrets/mq-credentials.properties:password}"

    mq.ssl.cipher.suite: "TLS_AES_256_GCM_SHA384"

    kafka.topic: "mq-source-topic"

    key.converter: "org.apache.kafka.connect.storage.StringConverter"
    value.converter: "org.apache.kafka.connect.converters.ByteArrayConverter"
keytool -importkeystore \
  -srckeystore client-keystore.p12 \
  -srcstoretype PKCS12 \
  -srcstorepass 'SOURCE_PASSWORD' \
  -destkeystore client-keystore.jks \
  -deststoretype JKS \
  -deststorepass 'DEST_PASSWORD' \
  -destkeypass 'DEST_PASSWORD'

keytool -importkeystore \
  -srckeystore client-truststore.p12 \
  -srcstoretype PKCS12 \
  -srcstorepass 'SOURCE_PASSWORD' \
  -destkeystore client-truststore.jks \
  -deststoretype JKS \
  -deststorepass 'DEST_PASSWORD'
