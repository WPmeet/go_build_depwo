{{- define "cfk.connector.source.mongodb.connection" -}}
{{- $root := .root -}}
{{- $connectorConfigs := .connectorConfigs -}}
{{- $configs := index $connectorConfigs "configs" | default dict -}}

{{- if and
      (hasKey $configs "database")
      (hasKey $root.Values.cfk.connector "source")
      (hasKey $root.Values.cfk.connector.source "connection")
-}}

{{- $connectionConfigs := deepCopy $root.Values.cfk.connector.source.connection -}}
{{- $database := index $configs "database" -}}

{{- if hasKey $connectionConfigs "connection.uri" -}}
{{- $connectionUri := printf "${file:/vault/secrets/connector/mongodb/%s-conn-uri:mongodb-connection-uri}" $database -}}
{{- $_ := set $connectionConfigs "connection.uri" $connectionUri -}}
{{- end -}}

{{- toYaml $connectionConfigs | nindent 4 }}
{{- end -}}
{{- end -}}

{{- define "cfk.connector.source.mq.connection" -}}
{{- $root := .root -}}
{{- $connectorConfigs := .connectorConfigs -}}
{{- $configs := index $connectorConfigs "configs" | default dict -}}

{{- if and
      (hasKey $configs "mq.queue.manager")
      (hasKey $root.Values.cfk.connector "source")
      (hasKey $root.Values.cfk.connector.source "connection")
-}}

{{- $sourceConnection := $root.Values.cfk.connector.source.connection -}}
{{- $mqConnection := dict -}}

{{- $mqProperties := list
      "mq.ssl.keystore.location"
      "mq.ssl.keystore.password"
      "mq.ssl.truststore.location"
      "mq.ssl.truststore.password"
      "mq.connection.user"
      "mq.connection.password"
-}}

{{- range $property := $mqProperties -}}
{{- if hasKey $sourceConnection $property -}}
{{- $_ := set $mqConnection $property (index $sourceConnection $property) -}}
{{- end -}}
{{- end -}}

{{- if gt (len $mqConnection) 0 }}
{{- toYaml $mqConnection | nindent 4 }}
{{- end -}}

{{- end -}}
{{- end -}}


