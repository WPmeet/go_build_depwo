{{- define "cfk.connector.source.connection" -}}
{{- $root := .root -}}

{{- if hasKey $root.Values.cfk.connector "source" -}}
  {{- $connectionConfigs := deepCopy
        ($root.Values.cfk.connector.source.connection | default dict) -}}

  {{- $connectorClass := $root.Values.cfk.connectorClass | default "" -}}

  {{/*
  Only MongoDB source connectors require connection.uri to be generated
  dynamically from the database name.

  MQ and other source connector configurations pass through unchanged.
  */}}
  {{- if hasSuffix "MongoSourceConnector" $connectorClass -}}
    {{- $database := required
          "cfk.connector.source.connection.database is required for MongoSourceConnector"
          (get $connectionConfigs "database") -}}

    {{- $connectionUri := printf
          "${file:/vault/secrets/connector/mongodb/%s-conn-uri:mongodb-connection-uri}"
          $database -}}

    {{- $_ := set $connectionConfigs "connection.uri" $connectionUri -}}
  {{- end -}}

  {{- toYaml $connectionConfigs | nindent 4 -}}
{{- end -}}
{{- end -}}

