$ErrorActionPreference = "Stop"

# ============================================================
# CONFIG
# ============================================================

$Repo = "https://digitalnexus02.systems.uk.hsbc:8081/nexus/repository/maven-group"

$RootGroup    = "com.google.cloud"
$RootArtifact = "pubsub-group-kafka-connector"
$RootVersion  = "1.3.3"

$OutputRoot = ".\pubsub-group-kafka-connector"
$LibDir     = Join-Path $OutputRoot "lib"
$PomCache   = Join-Path $OutputRoot "_pom-cache"

# Nexus credentials
$Username = "YOUR_NEXUS_USERNAME"
$Password = Read-Host "Enter Nexus password" -AsSecureString

$Credential = New-Object `
    System.Management.Automation.PSCredential(
        $Username,
        $Password
    )


# ============================================================
# CLEAN OUTPUT
# ============================================================

New-Item -ItemType Directory -Force -Path $OutputRoot | Out-Null
New-Item -ItemType Directory -Force -Path $LibDir     | Out-Null
New-Item -ItemType Directory -Force -Path $PomCache   | Out-Null


# ============================================================
# GLOBAL RESOLUTION STATE
# ============================================================

$ManagedVersions = @{}
$Processed       = @{}
$Downloaded      = @{}
$ResolvedGA      = @{}

$DependencyReport = @()


# ============================================================
# NEXUS DOWNLOAD
# ============================================================

function Invoke-NexusDownload {

    param(
        [string]$Url,
        [string]$OutFile
    )

    if (Test-Path $OutFile) {
        return
    }

    Write-Host "[GET] $Url" -ForegroundColor DarkGray

    Invoke-WebRequest `
        -Uri $Url `
        -OutFile $OutFile `
        -Credential $Credential
}


# ============================================================
# PROPERTY RESOLUTION
# ${grpc.version}, ${project.version}, etc.
# ============================================================

function Resolve-Value {

    param(
        [string]$Value,
        [hashtable]$Properties
    )

    if ([string]::IsNullOrWhiteSpace($Value)) {
        return $Value
    }

    $Result = $Value

    for ($i = 0; $i -lt 30; $i++) {

        if ($Result -notmatch '\$\{([^}]+)\}') {
            break
        }

        $PropertyName = $Matches[1]

        if (-not $Properties.ContainsKey($PropertyName)) {
            break
        }

        $Replacement = [string]$Properties[$PropertyName]

        $Result = $Result.Replace(
            '${' + $PropertyName + '}',
            $Replacement
        )
    }

    return $Result
}


# ============================================================
# GET POM
# ============================================================

function Get-Pom {

    param(
        [string]$Group,
        [string]$Artifact,
        [string]$Version
    )

    $GroupPath = $Group.Replace(".", "/")

    $SafeName =
        "$Group-$Artifact-$Version" -replace '[^\w\-.]', '_'

    $PomFile =
        Join-Path $PomCache "$SafeName.pom"

    $PomUrl =
        "$Repo/$GroupPath/$Artifact/$Version/$Artifact-$Version.pom"

    Invoke-NexusDownload `
        -Url $PomUrl `
        -OutFile $PomFile

    return [xml](Get-Content $PomFile -Raw)
}


# ============================================================
# COPY PROPERTIES
# ============================================================

function Add-PomProperties {

    param(
        [xml]$Pom,
        [hashtable]$Properties
    )

    if (-not $Pom.project.properties) {
        return
    }

    foreach ($Property in $Pom.project.properties.ChildNodes) {

        if ($Property.NodeType -eq "Element") {

            $Properties[$Property.Name] =
                $Property.InnerText.Trim()
        }
    }
}


# ============================================================
# LOAD PARENT PROPERTIES + DEPENDENCY MANAGEMENT
# ============================================================

function Import-PomContext {

    param(
        [xml]$Pom,
        [hashtable]$Properties
    )

    # --------------------------------------------------------
    # Parent first
    # --------------------------------------------------------

    if ($Pom.project.parent) {

        $ParentGroup =
            Resolve-Value `
                ([string]$Pom.project.parent.groupId) `
                $Properties

        $ParentArtifact =
            Resolve-Value `
                ([string]$Pom.project.parent.artifactId) `
                $Properties

        $ParentVersion =
            Resolve-Value `
                ([string]$Pom.project.parent.version) `
                $Properties

        if (
            $ParentGroup -and
            $ParentArtifact -and
            $ParentVersion
        ) {

            try {

                $ParentPom =
                    Get-Pom `
                        $ParentGroup `
                        $ParentArtifact `
                        $ParentVersion

                Import-PomContext `
                    $ParentPom `
                    $Properties

                Add-PomProperties `
                    $ParentPom `
                    $Properties
            }
            catch {

                Write-Warning `
                    "Could not process parent: $ParentGroup`:$ParentArtifact`:$ParentVersion"
            }
        }
    }


    # --------------------------------------------------------
    # Current properties override parent
    # --------------------------------------------------------

    Add-PomProperties `
        $Pom `
        $Properties


    # --------------------------------------------------------
    # dependencyManagement
    # --------------------------------------------------------

    if (-not $Pom.project.dependencyManagement) {
        return
    }

    foreach (
        $Dependency in
        $Pom.project.dependencyManagement.dependencies.dependency
    ) {

        $Group =
            Resolve-Value `
                ([string]$Dependency.groupId) `
                $Properties

        $Artifact =
            Resolve-Value `
                ([string]$Dependency.artifactId) `
                $Properties

        $Version =
            Resolve-Value `
                ([string]$Dependency.version) `
                $Properties

        $Type =
            [string]$Dependency.type

        $Scope =
            [string]$Dependency.scope

        if (-not $Type) {
            $Type = "jar"
        }


        # ----------------------------------------------------
        # Imported BOM
        # ----------------------------------------------------

        if (
            $Type -eq "pom" -and
            $Scope -eq "import"
        ) {

            if (
                $Group -and
                $Artifact -and
                $Version
            ) {

                Write-Host `
                    "[BOM] $Group`:$Artifact`:$Version" `
                    -ForegroundColor Yellow

                try {

                    $BomPom =
                        Get-Pom `
                            $Group `
                            $Artifact `
                            $Version

                    $BomProperties = @{}

                    foreach ($Key in $Properties.Keys) {
                        $BomProperties[$Key] = $Properties[$Key]
                    }

                    Import-PomContext `
                        $BomPom `
                        $BomProperties
                }
                catch {

                    Write-Warning `
                        "Could not process BOM: $Group`:$Artifact`:$Version"
                }
            }

            continue
        }


        # ----------------------------------------------------
        # Standard managed version
        # ----------------------------------------------------

        if (
            $Group -and
            $Artifact -and
            $Version
        ) {

            $ManagedVersions["$Group`:$Artifact"] =
                $Version
        }
    }
}


# ============================================================
# DOWNLOAD ONE JAR
# ============================================================

function Download-Jar {

    param(
        [string]$Group,
        [string]$Artifact,
        [string]$Version
    )

    $Coordinate =
        "$Group`:$Artifact`:$Version"

    if ($Downloaded.ContainsKey($Coordinate)) {
        return
    }

    $GroupPath =
        $Group.Replace(".", "/")

    $JarName =
        "$Artifact-$Version.jar"

    $JarUrl =
        "$Repo/$GroupPath/$Artifact/$Version/$JarName"

    $JarFile =
        Join-Path $LibDir $JarName

    try {

        Invoke-NexusDownload `
            -Url $JarUrl `
            -OutFile $JarFile

        $Downloaded[$Coordinate] = $true

        Write-Host `
            "[JAR] $Coordinate" `
            -ForegroundColor Green

        $script:DependencyReport += [PSCustomObject]@{
            GroupId    = $Group
            ArtifactId = $Artifact
            Version    = $Version
            File       = $JarName
        }
    }
    catch {

        Write-Warning `
            "Could not download JAR: $Coordinate"
    }
}


# ============================================================
# RECURSIVE RUNTIME DEPENDENCY RESOLUTION
# ============================================================

function Resolve-Dependencies {

    param(
        [string]$Group,
        [string]$Artifact,
        [string]$Version,
        [hashtable]$InheritedExclusions
    )

    $Coordinate =
        "$Group`:$Artifact`:$Version"

    if ($Processed.ContainsKey($Coordinate)) {
        return
    }

    $Processed[$Coordinate] = $true

    Write-Host ""
    Write-Host `
        "[PROCESS] $Coordinate" `
        -ForegroundColor Cyan


    # --------------------------------------------------------
    # Load POM
    # --------------------------------------------------------

    try {

        $Pom =
            Get-Pom `
                $Group `
                $Artifact `
                $Version
    }
    catch {

        Write-Warning `
            "Could not retrieve POM: $Coordinate"

        return
    }


    # --------------------------------------------------------
    # Build Maven properties
    # --------------------------------------------------------

    $Properties = @{}

    $Properties["project.groupId"] =
        $Group

    $Properties["project.artifactId"] =
        $Artifact

    $Properties["project.version"] =
        $Version

    $Properties["pom.groupId"] =
        $Group

    $Properties["pom.artifactId"] =
        $Artifact

    $Properties["pom.version"] =
        $Version


    Import-PomContext `
        $Pom `
        $Properties


    # --------------------------------------------------------
    # Process dependencies
    # --------------------------------------------------------

    if (-not $Pom.project.dependencies) {
        return
    }

    foreach (
        $Dependency in
        $Pom.project.dependencies.dependency
    ) {

        $Scope =
            [string]$Dependency.scope

        $Optional =
            [string]$Dependency.optional

        $Type =
            [string]$Dependency.type

        if (-not $Scope) {
            $Scope = "compile"
        }

        if (-not $Type) {
            $Type = "jar"
        }


        # ----------------------------------------------------
        # Runtime only
        # ----------------------------------------------------

        if (
            $Scope -eq "test" -or
            $Scope -eq "provided" -or
            $Scope -eq "system"
        ) {

            Write-Host `
                "[SKIP:$Scope] $($Dependency.groupId):$($Dependency.artifactId)" `
                -ForegroundColor DarkGray

            continue
        }


        if ($Optional -eq "true") {

            Write-Host `
                "[SKIP:optional] $($Dependency.groupId):$($Dependency.artifactId)" `
                -ForegroundColor DarkGray

            continue
        }


        if ($Type -ne "jar") {
            continue
        }


        # ----------------------------------------------------
        # Coordinates
        # ----------------------------------------------------

        $DepGroup =
            Resolve-Value `
                ([string]$Dependency.groupId) `
                $Properties

        $DepArtifact =
            Resolve-Value `
                ([string]$Dependency.artifactId) `
                $Properties

        $DepVersion =
            Resolve-Value `
                ([string]$Dependency.version) `
                $Properties


        # ----------------------------------------------------
        # Apply exclusion inherited from parent dependency
        # ----------------------------------------------------

        $GA =
            "$DepGroup`:$DepArtifact"

        if (
            $InheritedExclusions -and
            $InheritedExclusions.ContainsKey($GA)
        ) {

            Write-Host `
                "[SKIP:excluded] $GA" `
                -ForegroundColor DarkGray

            continue
        }


        # ----------------------------------------------------
        # Version from dependencyManagement/BOM
        # ----------------------------------------------------

        if (-not $DepVersion) {

            if ($ManagedVersions.ContainsKey($GA)) {

                $DepVersion =
                    Resolve-Value `
                        $ManagedVersions[$GA] `
                        $Properties
            }
        }


        if (
            -not $DepGroup -or
            -not $DepArtifact -or
            -not $DepVersion
        ) {

            Write-Warning `
                "UNRESOLVED dependency: $DepGroup : $DepArtifact : $DepVersion"

            continue
        }


        # ----------------------------------------------------
        # Maven-style first resolved version wins
        # Avoid putting multiple versions of same GA in lib
        # ----------------------------------------------------

        if ($ResolvedGA.ContainsKey($GA)) {

            if ($ResolvedGA[$GA] -ne $DepVersion) {

                Write-Host `
                    "[CONFLICT] $GA requested $DepVersion, already using $($ResolvedGA[$GA])" `
                    -ForegroundColor Magenta
            }

            continue
        }

        $ResolvedGA[$GA] =
            $DepVersion


        # ----------------------------------------------------
        # Collect exclusions declared on this dependency
        # ----------------------------------------------------

        $ChildExclusions = @{}

        if ($InheritedExclusions) {

            foreach ($Key in $InheritedExclusions.Keys) {
                $ChildExclusions[$Key] = $true
            }
        }


        if ($Dependency.exclusions) {

            foreach (
                $Exclusion in
                $Dependency.exclusions.exclusion
            ) {

                $ExGroup =
                    Resolve-Value `
                        ([string]$Exclusion.groupId) `
                        $Properties

                $ExArtifact =
                    Resolve-Value `
                        ([string]$Exclusion.artifactId) `
                        $Properties

                if (
                    $ExGroup -and
                    $ExArtifact
                ) {

                    $ChildExclusions[
                        "$ExGroup`:$ExArtifact"
                    ] = $true
                }
            }
        }


        # ----------------------------------------------------
        # Download INDIVIDUAL dependency JAR
        # ----------------------------------------------------

        Download-Jar `
            $DepGroup `
            $DepArtifact `
            $DepVersion


        # ----------------------------------------------------
        # Resolve its transitives
        # ----------------------------------------------------

        Resolve-Dependencies `
            $DepGroup `
            $DepArtifact `
            $DepVersion `
            $ChildExclusions
    }
}


# ============================================================
# START
#
# IMPORTANT:
# We resolve the connector POM but DO NOT download the
# 63MB shaded connector JAR.
# ============================================================

Write-Host ""
Write-Host "============================================"
Write-Host "Pub/Sub runtime dependency download"
Write-Host "============================================"
Write-Host ""

Write-Host "Connector:"
Write-Host "$RootGroup`:$RootArtifact`:$RootVersion"
Write-Host ""

Write-Host "The shaded connector JAR will NOT be downloaded."
Write-Host "Only individual runtime dependency JARs go into lib/."
Write-Host ""


$EmptyExclusions = @{}

Resolve-Dependencies `
    $RootGroup `
    $RootArtifact `
    $RootVersion `
    $EmptyExclusions


# ============================================================
# WRITE FOSS REPORT
# ============================================================

$CsvFile =
    Join-Path $OutputRoot "runtime-dependencies.csv"

$DependencyReport |
    Sort-Object GroupId, ArtifactId |
    Export-Csv `
        -Path $CsvFile `
        -NoTypeInformation


# ============================================================
# RESULT
# ============================================================

$Jars =
    Get-ChildItem `
        $LibDir `
        -Filter "*.jar"


Write-Host ""
Write-Host "============================================"
Write-Host "FINISHED"
Write-Host "============================================"

Write-Host ""
Write-Host "Individual runtime JARs: $($Jars.Count)"
Write-Host "JAR directory:"
Write-Host "  $LibDir"

Write-Host ""
Write-Host "Dependency report:"
Write-Host "  $CsvFile"

Write-Host ""
Write-Host "NOTE:"
Write-Host "  pubsub-group-kafka-connector-1.3.3.jar"
Write-Host "  is intentionally NOT in lib/."
Write-Host ""

$Jars |
    Sort-Object Name |
    Select-Object Name
