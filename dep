$ErrorActionPreference = "Stop"

$Repo = "https://digitalnexus02.systems.uk.hsbc:8081/nexus/repository/maven-group"
$OutputDir = ".\pubsub-group-kafka-connector\lib"

New-Item -ItemType Directory -Force -Path $OutputDir | Out-Null

$Username = "YOUR_NEXUS_USERNAME"
$Password = Read-Host "Enter Nexus password" -AsSecureString

$Credential = New-Object `
    System.Management.Automation.PSCredential(
        $Username,
        $Password
    )

$Dependencies = @(

    @("com.google.api.grpc", "proto-google-cloud-pubsublite-v1", "1.15.19"),
    @("com.google.cloud", "google-cloud-pubsublite", "1.15.19"),
    @("com.google.cloud", "pubsublite-kafka", "1.2.3"),

    @("com.google.cloud", "google-cloud-pubsub", "1.143.1"),
    @("com.google.api.grpc", "proto-google-cloud-pubsub-v1", "1.143.1"),

    @("org.apache.kafka", "kafka-clients", "3.9.1"),

    @("com.google.api", "gax", "2.72.1"),
    @("com.google.api", "gax-grpc", "2.72.1"),
    @("com.google.api", "api-common", "2.55.1"),

    @("com.google.protobuf", "protobuf-java", "4.33.0"),
    @("com.google.protobuf", "protobuf-java-util", "4.33.0"),

    @("com.google.auth", "google-auth-library-credentials", "1.39.1"),
    @("com.google.auth", "google-auth-library-oauth2-http", "1.39.1"),

    @("com.google.guava", "guava", "33.4.8-jre"),
    @("com.google.guava", "failureaccess", "1.0.3"),

    @("com.google.code.findbugs", "jsr305", "3.0.2"),
    @("com.google.flogger", "google-extensions", "0.8"),
    @("org.threeten", "threetenbp", "1.7.1"),
    @("com.google.errorprone", "error_prone_annotations", "2.41.0"),

    @("org.slf4j", "slf4j-api", "2.0.17")
)

foreach ($Dep in $Dependencies) {

    $Group    = $Dep[0]
    $Artifact = $Dep[1]
    $Version  = $Dep[2]

    $GroupPath = $Group.Replace(".", "/")
    $JarName = "$Artifact-$Version.jar"

    $Url = "$Repo/$GroupPath/$Artifact/$Version/$JarName"
    $Destination = Join-Path $OutputDir $JarName

    Write-Host "[DOWNLOAD] $Group`:$Artifact`:$Version" -ForegroundColor Cyan

    try {
        Invoke-WebRequest `
            -Uri $Url `
            -OutFile $Destination `
            -Credential $Credential

        Write-Host "  OK -> $JarName" -ForegroundColor Green
    }
    catch {
        Write-Host "  FAILED -> $Url" -ForegroundColor Red
    }
}

Write-Host ""
Write-Host "Downloaded:"
Get-ChildItem $OutputDir -Filter "*.jar" |
    Sort-Object Name |
    Select-Object Name
