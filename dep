$ErrorActionPreference = "Stop"

# ============================================================
# CONFIGURATION
# ============================================================

# Your corporate Nexus Maven repository
$Repo = "https://digitalnexus02.systems.uk.hsbc:8081/nexus/repository/maven-group"

# Connector we want to resolve
$RootGroup    = "com.google.cloud"
$RootArtifact = "pubsub-group-kafka-connector"
$RootVersion  = "1.3.3"

# Output
$OutputRoot = ".\pubsub-group-kafka-connector"
$LibDir     = Join-Path $OutputRoot "lib"
$PomCache   = Join-Path $OutputRoot "_pom-cache"

New-Item -ItemType Directory -Force -Path $OutputRoot | Out-Null
New-Item -ItemType Directory -Force -Path $LibDir     | Out-Null
New-Item -ItemType Directory -Force -Path $PomCache   | Out-Null


# ============================================================
# NEXUS CREDENTIALS
# ============================================================

# CHANGE THIS to the same Nexus username used in settings.xml
$Username = "YOUR_NEXUS_USERNAME"

# Password will be requested when script starts.
# Nothing is saved in this file.
$Password = Read-Host "Enter Nexus password" -AsSecureString

$Credential = New-Object `
    System.Management.Automation.PSCredential(
        $Username,
        $Password
    )


# ============================================================
# STATE
# ============================================================

$Processed = @{}
$ManagedVersions = @{}


# ============================================================
# DOWNLOAD FROM NEXUS
# ============================================================

function Invoke-NexusDownload {

    param(
        [string]$Url,
        [string]$OutFile
    )

    if (Test-Path $OutFile) {
        Write-Host "[CACHE] $OutFile" -ForegroundColor DarkGray
        return
    }

    Write-Host "[GET] $Url"

    Invoke-WebRequest `
        -Uri $Url `
        -OutFile $OutFile `
        -Credential $Credential
}


# ============================================================
# PROPERTY RESOLUTION
# e.g. ${grpc.version}
# ============================================================

function Resolve-Value {

    param(
        [string]$Value,
        [hashtable]$Props
    )

    if ([string]::IsNullOrWhiteSpace($Value)) {
        return $Value
    }

    $result = $Value

    for ($i = 0; $i -lt 30; $i++) {

        if ($result -notmatch '\$\{([^}]+)\}') {
            break
        }

        $propertyName = $Matches[1]

        if (-not $Props.ContainsKey($propertyName)) {
            break
        }

        $replacement = [string]$Props[$propertyName]

        $result = $result.Replace(
            '${' + $propertyName + '}',
            $replacement
        )
    }

    return $result
}


# ============================================================
# GET POM
# ============================================================

function Get-Pom {

    param(
        [string]$Group,
        [string]$Artifact,
        [string]$Version
    )

    $GroupPath = $Group.Replace(".", "/")

    $SafeName = "$Group-$Artifact-$Version" `
        -replace '[^\w\-\.]', '_'

    $PomFile = Join-Path $PomCache "$SafeName.pom"

    $PomUrl =
        "$Repo/$GroupPath/$Artifact/$Version/$Artifact-$Version.pom"

    Invoke-NexusDownload `
        -Url $PomUrl `
        -OutFile $PomFile

    return [xml](Get-Content $PomFile -Raw)
}


# ============================================================
# READ PROPERTIES FROM POM
# ============================================================

function Add-PomProperties {

    param(
        [xml]$Pom,
        [hashtable]$Props
    )

    if ($Pom.project.properties) {

        foreach ($Property in $Pom.project.properties.ChildNodes) {

            if ($Property.NodeType -eq "Element") {

                $Props[$Property.Name] =
                    $Property.InnerText.Trim()
            }
        }
    }
}


# ============================================================
# IMPORT DEPENDENCY MANAGEMENT / BOM
# ============================================================

function Import-DependencyManagement {

    param(
        [xml]$Pom,
        [hashtable]$Props
    )

    if (-not $Pom.project.dependencyManagement) {
        return
    }

    $Dependencies =
        $Pom.project.dependencyManagement.dependencies.dependency

    foreach ($Dependency in $Dependencies) {

        $Group =
            Resolve-Value ([string]$Dependency.groupId) $Props

        $Artifact =
            Resolve-Value ([string]$Dependency.artifactId) $Props

        $Version =
            Resolve-Value ([string]$Dependency.version) $Props

        $Type  = [string]$Dependency.type
        $Scope = [string]$Dependency.scope

        if (-not $Type) {
            $Type = "jar"
        }


        # ----------------------------------------------------
        # Imported Maven BOM
        # ----------------------------------------------------

        if ($Type -eq "pom" -and $Scope -eq "import") {

            if ($Group -and $Artifact -and $Version) {

                Write-Host `
                    "[BOM] $Group`:$Artifact`:$Version" `
                    -ForegroundColor Yellow

                try {

                    $BomPom =
                        Get-Pom `
                            $Group `
                            $Artifact `
                            $Version

                    $BomProps = @{}

                    foreach ($Key in $Props.Keys) {
                        $BomProps[$Key] = $Props[$Key]
                    }

                    Add-PomProperties `
                        $BomPom `
                        $BomProps

                    Import-DependencyManagement `
                        $BomPom `
                        $BomProps
                }
                catch {

                    Write-Warning `
                        "Unable to process BOM: $Group`:$Artifact`:$Version"
                }
            }

            continue
        }


        # ----------------------------------------------------
        # Normal managed dependency
        # ----------------------------------------------------

        if ($Group -and $Artifact -and $Version) {

            $Key = "$Group`:$Artifact"

            $ManagedVersions[$Key] = $Version
        }
    }
}


# ============================================================
# PROCESS ARTIFACT
# ============================================================

function Process-Artifact {

    param(
        [string]$Group,
        [string]$Artifact,
        [string]$Version,
        [bool]$DownloadJar = $true
    )

    $Key = "$Group`:$Artifact`:$Version"

    if ($Processed.ContainsKey($Key)) {
        return
    }

    $Processed[$Key] = $true

    Write-Host ""
    Write-Host "==========================================" `
        -ForegroundColor Cyan

    Write-Host "Processing $Key" `
        -ForegroundColor Cyan

    Write-Host "==========================================" `
        -ForegroundColor Cyan


    # --------------------------------------------------------
    # GET POM
    # --------------------------------------------------------

    try {

        $Pom =
            Get-Pom `
                $Group `
                $Artifact `
                $Version
    }
    catch {

        Write-Warning "Could not download POM: $Key"
        return
    }


    # --------------------------------------------------------
    # LOCAL PROPERTY MAP
    # --------------------------------------------------------

    $Props = @{

        "project.groupId"    = $Group
        "project.artifactId" = $Artifact
        "project.version"    = $Version

        "pom.groupId"        = $Group
        "pom.artifactId"     = $Artifact
        "pom.version"        = $Version
    }

    Add-PomProperties `
        $Pom `
        $Props


    # --------------------------------------------------------
    # PARENT POM
    # --------------------------------------------------------

    if ($Pom.project.parent) {

        $ParentGroup =
            Resolve-Value `
                ([string]$Pom.project.parent.groupId) `
                $Props

        $ParentArtifact =
            Resolve-Value `
                ([string]$Pom.project.parent.artifactId) `
                $Props

        $ParentVersion =
            Resolve-Value `
                ([string]$Pom.project.parent.version) `
                $Props

        if (
            $ParentGroup -and
            $ParentArtifact -and
            $ParentVersion
        ) {

            Write-Host `
                "[PARENT] $ParentGroup`:$ParentArtifact`:$ParentVersion" `
                -ForegroundColor DarkYellow

            try {

                $ParentPom =
                    Get-Pom `
                        $ParentGroup `
                        $ParentArtifact `
                        $ParentVersion

                Add-PomProperties `
                    $ParentPom `
                    $Props

                Import-DependencyManagement `
                    $ParentPom `
                    $Props
            }
            catch {

                Write-Warning `
                    "Unable to process parent POM: $ParentGroup`:$ParentArtifact`:$ParentVersion"
            }
        }
    }


    # --------------------------------------------------------
    # CURRENT POM DEPENDENCY MANAGEMENT
    # --------------------------------------------------------

    Import-DependencyManagement `
        $Pom `
        $Props


    # --------------------------------------------------------
    # DOWNLOAD THIS ARTIFACT JAR
    # --------------------------------------------------------

    if ($DownloadJar) {

        $GroupPath = $Group.Replace(".", "/")

        $JarName =
            "$Artifact-$Version.jar"

        $JarUrl =
            "$Repo/$GroupPath/$Artifact/$Version/$JarName"

        $JarFile =
            Join-Path $LibDir $JarName

        try {

            Invoke-NexusDownload `
                -Url $JarUrl `
                -OutFile $JarFile

            Write-Host `
                "[JAR] $Key" `
                -ForegroundColor Green
        }
        catch {

            Write-Warning `
                "Could not download JAR: $Key"
        }
    }


    # --------------------------------------------------------
    # PROCESS DEPENDENCIES
    # --------------------------------------------------------

    if (-not $Pom.project.dependencies) {
        return
    }

    foreach (
        $Dependency in
        $Pom.project.dependencies.dependency
    ) {

        $Scope =
            [string]$Dependency.scope

        $Optional =
            [string]$Dependency.optional

        $Type =
            [string]$Dependency.type


        if (-not $Scope) {
            $Scope = "compile"
        }

        if (-not $Type) {
            $Type = "jar"
        }


        # ----------------------------------------------------
        # DO NOT PACKAGE THESE
        # ----------------------------------------------------

        if (
            $Scope -in @(
                "test",
                "provided",
                "system"
            )
        ) {

            Write-Host `
                "[SKIP:$Scope] $($Dependency.groupId):$($Dependency.artifactId)" `
                -ForegroundColor DarkGray

            continue
        }


        if ($Optional -eq "true") {

            Write-Host `
                "[SKIP:optional] $($Dependency.groupId):$($Dependency.artifactId)" `
                -ForegroundColor DarkGray

            continue
        }


        if ($Type -ne "jar") {
            continue
        }


        # ----------------------------------------------------
        # RESOLVE COORDINATES
        # ----------------------------------------------------

        $DepGroup =
            Resolve-Value `
                ([string]$Dependency.groupId) `
                $Props

        $DepArtifact =
            Resolve-Value `
                ([string]$Dependency.artifactId) `
                $Props

        $DepVersion =
            Resolve-Value `
                ([string]$Dependency.version) `
                $Props


        # ----------------------------------------------------
        # VERSION FROM dependencyManagement/BOM
        # ----------------------------------------------------

        if (-not $DepVersion) {

            $ManagedKey =
                "$DepGroup`:$DepArtifact"

            if (
                $ManagedVersions.ContainsKey(
                    $ManagedKey
                )
            ) {

                $DepVersion =
                    Resolve-Value `
                        $ManagedVersions[$ManagedKey] `
                        $Props
            }
        }


        # ----------------------------------------------------
        # VALIDATE
        # ----------------------------------------------------

        if (
            -not $DepGroup -or
            -not $DepArtifact -or
            -not $DepVersion
        ) {

            Write-Warning `
                "UNRESOLVED: $DepGroup : $DepArtifact : $DepVersion"

            continue
        }


        Write-Host `
            "[DEPENDENCY] $DepGroup`:$DepArtifact`:$DepVersion"


        # ----------------------------------------------------
        # RECURSE
        # ----------------------------------------------------

        Process-Artifact `
            $DepGroup `
            $DepArtifact `
            $DepVersion `
            $true
    }
}


# ============================================================
# START FROM GOOGLE PUBSUB CONNECTOR
# ============================================================

Write-Host ""
Write-Host "Starting Pub/Sub connector dependency download..." `
    -ForegroundColor Cyan

Process-Artifact `
    $RootGroup `
    $RootArtifact `
    $RootVersion `
    $true


# ============================================================
# RESULTS
# ============================================================

Write-Host ""
Write-Host "==========================================" `
    -ForegroundColor Cyan

Write-Host "DOWNLOAD FINISHED" `
    -ForegroundColor Cyan

Write-Host "==========================================" `
    -ForegroundColor Cyan


$Jars =
    Get-ChildItem `
        $LibDir `
        -Filter "*.jar"


Write-Host ""
Write-Host "Downloaded JARs: $($Jars.Count)"
Write-Host "Directory: $LibDir"
Write-Host ""

$Jars |
    Sort-Object Name |
    Select-Object Name
