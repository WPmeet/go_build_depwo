$ErrorActionPreference = "Stop"

# ==========================================
# CONFIG
# ==========================================

$Repo = "https://digitalnexus02.systems.uk.hsbc:8081/nexus/repository/maven-group"

$OutputDir = ".\pubsub-group-kafka-connector\lib"

New-Item -ItemType Directory -Force -Path $OutputDir | Out-Null

# ==========================================
# NEXUS CREDS
# ==========================================

$Username = "YOUR_NEXUS_USERNAME"
$Password = Read-Host "Enter Nexus password" -AsSecureString

$Credential = New-Object `
    System.Management.Automation.PSCredential(
        $Username,
        $Password
    )

# ==========================================
# STATIC JAR ARRAY
# groupId | artifactId | version
# ==========================================

$Dependencies = @(

    # Pub/Sub / Pub/Sub Lite
    @("com.google.api.grpc", "proto-google-cloud-pubsublite-v1", "TODO"),
    @("com.google.cloud", "google-cloud-pubsublite", "TODO"),
    @("com.google.cloud", "pubsublite-kafka", "2.3.3"),
    @("com.google.cloud", "google-cloud-pubsub", "TODO"),

    # Protobuf
    @("com.google.protobuf", "protobuf-java", "TODO"),
    @("com.google.protobuf", "protobuf-java-util", "TODO"),

    # Google API / GAX
    @("com.google.api", "gax", "TODO"),
    @("com.google.api", "gax-grpc", "TODO"),
    @("com.google.api", "api-common", "TODO"),

    # gRPC
    @("io.grpc", "grpc-api", "TODO"),

    # Authentication
    @("com.google.auth", "google-auth-library-credentials", "TODO"),
    @("com.google.auth", "google-auth-library-oauth2-http", "TODO"),

    # Utility libraries
    @("com.google.guava", "guava", "TODO"),
    @("org.threeten", "threetenbp", "TODO"),
    @("com.google.errorprone", "error_prone_annotations", "TODO"),

    # Logging
    @("org.slf4j", "slf4j-api", "2.0.17"),

    # Google logging/extensions
    @("com.google.flogger", "google-extensions", "0.8")

)

# ==========================================
# DOWNLOAD
# ==========================================

foreach ($Dependency in $Dependencies) {

    $Group    = $Dependency[0]
    $Artifact = $Dependency[1]
    $Version  = $Dependency[2]

    if ($Version -eq "TODO") {
        Write-Warning "VERSION NEEDED: $Group`:$Artifact"
        continue
    }

    $GroupPath = $Group.Replace(".", "/")

    $JarName = "$Artifact-$Version.jar"

    $Url =
        "$Repo/$GroupPath/$Artifact/$Version/$JarName"

    $Destination =
        Join-Path $OutputDir $JarName

    Write-Host ""
    Write-Host "[JAR] $Group`:$Artifact`:$Version" -ForegroundColor Cyan

    try {

        Invoke-WebRequest `
            -Uri $Url `
            -OutFile $Destination `
            -Credential $Credential

        Write-Host "Downloaded -> $JarName" -ForegroundColor Green

    }
    catch {

        Write-Warning "FAILED: $Group`:$Artifact`:$Version"
    }
}

Write-Host ""
Write-Host "============================="
Write-Host "FINISHED"
Write-Host "============================="

Get-ChildItem $OutputDir -Filter "*.jar" |
    Sort-Object Name |
    Select-Object Name
